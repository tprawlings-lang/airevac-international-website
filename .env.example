# Copy to .env.local for local development. Never commit .env.local.
#
# There are deliberately no secrets here. Blueprint page 16 requires a managed
# vault or secret service and "no source or CI output" for secrets — so when the
# CMS, chat vendor, intake vendor, and JetInsight adapter are wired up (D7/D8),
# their credentials belong in the secret store, not in this file.

# Public origin. Controls canonical URLs, hreflang, sitemap, structured data,
# and the robots policy.
#
# IMPORTANT: any value other than the production origin below causes the site to
# emit `noindex` and a disallow-all robots.txt. That is intentional — staging
# cannot be indexed by forgetting a flag.
SITE_URL=http://localhost:3000

# Production value:
# SITE_URL=https://airevacinternational.com
