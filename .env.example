# Copy to .env.local for local development. Never commit .env.local.
#
# There are deliberately no secrets here. Blueprint page 16 requires a managed
# vault or secret service and "no source or CI output" for secrets — so when the
# CMS, chat vendor, intake vendor, and JetInsight adapter are wired up (D7/D8),
# their credentials belong in the secret store, not in this file.

# Public origin. Controls canonical URLs, hreflang, sitemap, structured data,
# and the robots policy.
#
# IMPORTANT: any value other than the production origin below causes the site to
# emit `noindex` and a disallow-all robots.txt. That is intentional — staging
# cannot be indexed by forgetting a flag.
SITE_URL=http://localhost:3000

# Production value:
# SITE_URL=https://airevacinternational.com

# ---------------------------------------------------------------------------
# Coordinator console (Phase A). Absent, the console is simply unavailable.
# ---------------------------------------------------------------------------

# Postgres. TLS is required unless the host is local; see src/server/db/client.ts.
# DATABASE_URL=postgresql://airevac:devonly@127.0.0.1:5432/airevac_dev
# DATABASE_SSL=disable

# Seeds the first admin as admin/admin, forced to change on first sign-in.
# Only works while no admin exists. Never set this in production.
# ALLOW_BOOTSTRAP_ADMIN=true
# BOOTSTRAP_ADMIN_EMAIL=admin@aeiamericas.com

# ---------------------------------------------------------------------------
# Outbound notifications
# ---------------------------------------------------------------------------
# TESTING ADDRESS. Callback-form notifications carry a name, phone number, and
# the cities involved. Move this to the operations mailbox before the site
# accepts real enquiries.
# OPS_NOTIFICATION_EMAIL=tp.rawlings@icloud.com

# Without a key, mail is logged rather than sent. That is a working state.
# RESEND_API_KEY=
# MAIL_FROM=AirEvac Website <notifications@airevacinternational.com>

# ---------------------------------------------------------------------------
# AWS Translate (Phase C). Absent, chat runs untranslated and says so.
# ---------------------------------------------------------------------------
# Requires an executed AWS Business Associate Addendum before real
# conversations pass through it: message text leaves our systems for theirs.
#
# Use an IAM user whose ONLY permission is translate:TranslateText. Not root
# credentials, and nothing broader: this key sits in a web application.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Chat. See docs/testing-on-render.md.
# ---------------------------------------------------------------------------
# Turns on the public widget and every chat endpoint. Must stay false on the
# production origin until the Business Associate Agreement is executed.
# CHAT_ENABLED=true

# 'stub' produces visibly marked placeholder translations so the translated
# view can be tested before AWS exists. Refused on the production origin.
# TRANSLATION_MODE=stub

# Days a transcript is kept. Provisional pending D9.
# CHAT_RETENTION_DAYS=30
